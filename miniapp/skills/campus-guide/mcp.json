{
  "apis": [
    {
      "name": "getServiceCatalog",
      "description": "读取CampusPilot演示校园服务目录、事项名称、所需材料与字段。只读公共演示指南，不读取个人任务，不提交申请。",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "description": { "type": "string" },
                "category": { "type": "string" },
                "materials": { "type": "array", "items": { "type": "string" } },
                "fields": { "type": "array", "items": { "type": "string" } },
                "office": { "type": "string" }
              }
            }
          },
          "knowledgeMode": { "type": "string" }
        }
      }
    }
  ]
}
