.bar{display:flex;position:fixed;bottom:0;left:0;right:0;background:#101c2f;border-top:1rpx solid #26354c;padding:14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));z-index:50}.tab{flex:1;display:flex;align-items:center;flex-direction:column;color:#8193af;font-size:21rpx;min-height:80rpx;position:relative}.tab image{width:43rpx;height:43rpx;margin-bottom:7rpx}.active{color:#30e0c1}.dot{width:8rpx;height:8rpx;border-radius:50%;background:#30e0c1;position:absolute;top:-8rpx}