<view class="bar"><view wx:for="{{list}}" wx:key="name" class="tab {{selected===index?'active':''}}" data-index="{{index}}" bindtap="switchTab"><image src="/assets/tabbar/{{item.name}}{{selected===index?'-active':''}}.png"/><text>{{item.text}}</text><view wx:if="{{selected===index}}" class="dot"/></view></view>