<view class="page"><text class="eyebrow">SOURCE / TRACEABLE EVIDENCE</text><view class="heading">{{doc.title || '规则来源'}}</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{quote}}" class="card"><text class="badge">本次引用</text><view class="source-text gap">{{quote}}</view></view><view wx:if="{{doc}}"><view class="notice">{{doc.notice}} · 版本 {{doc.version}}</view><button wx:if="{{doc.sourceUrl}}" class="secondary" bindtap="copy">复制原始网页链接</button><view wx:for="{{doc.sections}}" wx:key="index" class="card"><text class="badge">{{item.label}}</text><text class="source-text" selectable>{{item.text}}</text></view></view></view>
