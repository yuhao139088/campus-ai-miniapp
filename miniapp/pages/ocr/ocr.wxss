.scan-frame{height:200rpx;border:2rpx dashed #416477;border-radius:22rpx;display:flex;align-items:center;justify-content:center;color:#92c4c7;font-size:23rpx;position:relative;overflow:hidden}.scan-line{display:none;position:absolute;left:0;right:0;height:4rpx;background:#36e4ca;box-shadow:0 0 35rpx #36e4ca}.scanning .scan-line{display:block;animation:scan 2s ease-in-out infinite}@keyframes scan{0%,100%{top:0}50%{top:100%}}