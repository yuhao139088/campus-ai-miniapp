.school-select{display:flex;justify-content:space-between;padding:24rpx;background:#0a1526;border:1rpx solid #3e6266;border-radius:18rpx;color:#b9f6e7}.import-modes{display:flex;flex-wrap:wrap}.selected{background:#164c46;color:#85ffe1;border-color:#55d9bd}.doc-preview{font-size:24rpx;color:#acbccd;line-height:1.8;margin:20rpx 0;max-height:130rpx;overflow:hidden}.library-page .card{animation:arrive .28s ease-out}@keyframes arrive{from{opacity:.3;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)} }
