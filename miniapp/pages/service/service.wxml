<view class="page"><text class="eyebrow">SERVICE DIRECTORY</text><view class="heading">校园事务指南</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{services}}" wx:key="id" class="pill" bindtap="choose" data-id="{{item.id}}">{{item.title}}</view><view wx:if="{{selected}}" class="card"><text class="badge">{{selected.category}}</text><view class="heading">{{selected.title}}</view><view class="muted">{{selected.description}}</view><view class="divider"/><text class="section-title">准备这些材料</text><view wx:for="{{selected.materials}}" wx:key="*this" class="step"><text class="badge">0{{index+1}}</text><text>{{item}}</text></view><view class="muted gap">咨询窗口：{{selected.office}}</view><button class="gap" bindtap="ask">让 AI 为我规划 ↗</button></view><view class="notice">以上为示例流程，不是任何具体学校的正式办事通知。</view></view>