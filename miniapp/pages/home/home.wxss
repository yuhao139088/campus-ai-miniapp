.hero{position:relative;overflow:hidden;padding-top:210rpx}.campus{position:absolute;top:0;right:0;width:100%;height:250rpx;opacity:.8}.hero text,.hero-title,.hero button,.hero .muted{position:relative}.hero-title{font-size:42rpx;font-weight:650;margin:12rpx 0}.services{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.service-card{padding:26rpx 20rpx;border:1rpx solid #273851;border-radius:24rpx;background:#101e33}.service-name{font-size:28rpx;font-weight:600;margin:22rpx 0 12rpx}