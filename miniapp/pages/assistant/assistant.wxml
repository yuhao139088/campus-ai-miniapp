<view class="page">
  <text class="eyebrow">CAMPUS INTELLIGENCE</text>
  <view class="heading">先看规则，<view>再决定下一步。</view></view>
  <view class="context-strip" bindtap="library"><text>{{school?school.name+' '+school.campus:'演示校园 · 选择真实资料库'}}</text><text>切换 / 导入 ↗</text></view>
  <view class="card">
    <textarea value="{{message}}" bindinput="input" maxlength="2000" placeholder="例如：根据今年通知，我能申请这项奖学金吗？还缺什么材料？" disabled="{{loading}}"/>
    <view wx:if="{{school}}"><text class="field-label gap">已知个人情况 · 每行“字段：内容”</text><textarea class="profile-input" value="{{profileText}}" bindinput="profileInput" maxlength="3000" placeholder="绩点：3.85&#10;年级：大二&#10;是否违纪：否"/><view class="notice">只提供本次判断需要的信息；姓名、学号、电话不参与资格模型推理。</view></view>
    <button class="gap" bindtap="send" loading="{{loading}}" disabled="{{loading || !message}}">{{loading?'正在对照规则与检查材料':school?(run?'补充信息，重新核验 ↗':'按学校资料核验 ↗'):'生成演示办理计划 ↗'}}</button>
    <view wx:if="{{!school}}"><text wx:for="{{hints}}" wx:key="*this" class="pill" data-index="{{index}}" bindtap="hint">{{item}}</text><view class="notice">演示规则仅用于体验；使用真实通知请先建立个人学校资料库。</view></view>
  </view>
  <view wx:if="{{loading}}" class="card processing"><view class="scan-progress"/><text class="badge">检索资料 → 核验条件 → 检查缺项 → 验证引文</text><view class="muted gap">每条判断都需要资料依据；复杂核验可能需要一分钟。</view></view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <view wx:if="{{run}}">
    <view class="card"><view class="row"><text class="section-title">{{run.title || '你的办理计划'}}</text><text class="badge">{{run.mode==='live'?'实时 AI':run.mode==='fallback'?'核验未完成':'待配置'}}</text></view><text class="muted" selectable>{{run.answer}}</text><view wx:if="{{run.warning}}" class="error">{{run.knowledgeMode?run.warning:'模型暂时不可用，当前显示演示参考清单。'}}</view></view>
    <view wx:if="{{run.knowledgeMode==='imported'}}">
      <view class="card"><view class="row"><text class="section-title">资格条件核验</text><text class="badge">{{eligibilityLabel}}</text></view>
        <view wx:if="{{!run.criteria.length}}" class="muted">未找到可核验条件，请补充适用通知或明确问题。</view>
        <view wx:for="{{run.criteria}}" wx:key="index" class="criterion"><view class="row"><text class="criterion-title">{{item.rule}}</text><text class="verdict {{item.status}}">{{item.status==='met'?'初步符合':item.status==='unmet'?'不符合':'待补充'}}</text></view><view class="muted small">{{item.explanation}}</view></view>
        <view class="notice">结论仅为资料对照，不代表学校资格认定或录取、获奖结果。</view>
      </view>
      <view wx:if="{{run.questions.length}}" class="card questions"><text class="section-title">补充这些信息，才能继续</text><view wx:for="{{run.questions}}" wx:key="key" class="question"><text class="badge">{{item.key}}</text><view>{{item.question}}</view></view><view class="notice">在上方个人情况中按字段填写，再点击重新核验。</view></view>
      <view wx:if="{{run.materials.length}}" class="card"><text class="section-title">材料准备清单</text><view wx:for="{{run.materials}}" wx:key="name" class="material-row" data-index="{{index}}" bindtap="material"><text class="material-check {{item.status==='provided'?'checked':''}}">{{item.status==='provided'?'✓':'＋'}}</text><view class="step-body"><view>{{item.name}}</view><text class="badge small">{{item.statusText}}</text><view class="muted small">{{item.guidance}}</view></view></view><view class="notice">点击标记本人已准备，AI将重新核验。标记不代表校方接受；识别材料可用于进一步核对。</view></view>
      <view wx:if="{{run.deadline}}" class="card deadline"><text class="eyebrow">DEADLINE</text><view class="heading">{{run.deadline.date}}</view><text class="badge">{{run.deadline.expired?'这个日期已过，请核对最新通知':'通知中可核验的截止日期'}}</text><view class="muted">{{run.deadline.explanation}}</view></view>
    </view>
    <view wx:if="{{run.steps.length}}" class="card"><text class="section-title">办理计划</text><view wx:for="{{run.steps}}" wx:key="index" class="step"><text class="step-no">{{index+1}}</text><view class="step-body"><view>{{item.title}}</view><view class="muted small">{{item.description}}</view></view></view></view>
    <view class="card"><text class="section-title">依据与核验记录</text><view wx:for="{{run.trace}}" wx:key="index" class="muted small">✓ {{item.tool}}</view><view wx:for="{{run.citations}}" wx:key="sourceId" class="citation" data-index="{{index}}" bindtap="source"><text class="badge">{{item.title}} {{item.label}} {{item.documentId?'↗':''}}</text><view wx:if="{{item.quote}}" class="quote">“{{item.quote}}”</view></view></view>
    <view class="stack" wx:if="{{run.steps.length}}"><button bindtap="ocr">上传材料并识别</button><button wx:if="{{!run.knowledgeMode || run.formFields.length}}" class="secondary" bindtap="form">生成可编辑表单</button><button class="secondary" bindtap="save">保存为办理任务</button></view>
  </view>
  <view class="notice">请勿上传无关敏感信息。资料与个人情况可发送至已配置模型；所有草稿由本人核对，学校审批仍通过正式渠道。</view>
</view>
