.context-strip{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #2b4e54;color:#a6ebdb;font-size:24rpx}.profile-input{height:190rpx}.criterion{padding:24rpx 0;border-bottom:1rpx solid #28394c}.criterion-title{flex:1;font-weight:600;font-size:27rpx}.verdict{font-size:21rpx;padding:8rpx 12rpx;border-radius:10rpx;white-space:nowrap;background:#3b3527;color:#f6d49b}.verdict.met{background:#16493f;color:#9cebd0}.verdict.unmet{background:#442e34;color:#ffb7c2}.question{padding:18rpx 0;font-size:26rpx;line-height:1.7}.questions{border-color:#716142}.material-row{display:flex;gap:20rpx;padding:22rpx 0;border-bottom:1rpx solid #28394c}.material-check{width:46rpx;height:46rpx;line-height:44rpx;border:1rpx solid #50726c;border-radius:14rpx;text-align:center;flex-shrink:0}.checked{background:#1e574a;color:#9dffe1}.citation{border-left:3rpx solid #4cbba8;padding:8rpx 18rpx;margin-top:24rpx}.quote{font-size:25rpx;color:#c8d5de;line-height:1.8;margin-top:12rpx}.deadline{border-color:#567c75;background:#112b30}.processing{position:relative;overflow:hidden}.scan-progress{height:3rpx;position:absolute;top:0;left:0;width:35%;background:#6bffe0;animation:scan 1.8s linear infinite}@keyframes scan{from{transform:translateX(-100%)}to{transform:translateX(400%)}}
