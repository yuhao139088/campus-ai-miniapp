page{background:#081021;color:#eef5ff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;font-size:28rpx}view,text,button,input,textarea{box-sizing:border-box}button::after{border:none}button{font-size:27rpx;border-radius:22rpx;background:#30e0c1;color:#062820;min-height:88rpx;line-height:88rpx;margin:0;font-weight:600}button[disabled]{opacity:.42;background:#507171;color:#b4c7c5}.page{padding:34rpx 30rpx 190rpx}.eyebrow{font-size:20rpx;color:#52ddc8;letter-spacing:4rpx}.heading{font-size:46rpx;font-weight:700;line-height:1.35;margin:18rpx 0}.muted{color:#9aacbf;font-size:25rpx;line-height:1.8}.card{border:1rpx solid #273851;background:#101e33;border-radius:30rpx;padding:30rpx;margin:24rpx 0}.section-title{font-size:31rpx;font-weight:650;display:block;margin-bottom:16rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.tag{font-size:20rpx;background:#193f43;color:#6ae9d3;border-radius:12rpx;padding:8rpx 14rpx;display:inline-block;margin:10rpx 12rpx 0 0}.secondary{background:#1d304c;color:#d8e5f5;border:1rpx solid #344963}.stack button{margin-top:20rpx}input,textarea{background:#0a1526;border:1rpx solid #30435d;border-radius:18rpx;color:#edf7ff;width:100%;font-size:28rpx}
/* Native input has an intrinsic height: vertical padding would squeeze its text. */
input{height:96rpx;min-height:96rpx;line-height:48rpx;padding:0 22rpx}
textarea{height:200rpx;padding:22rpx;line-height:1.6}.field{margin:26rpx 0}.field-label{font-size:25rpx;margin-bottom:12rpx;display:block;color:#bdcddd}.error{color:#ffb1a8;font-size:24rpx;margin-top:12rpx;line-height:1.6}.notice{color:#a2b2c7;font-size:22rpx;line-height:1.7;padding:18rpx 0}.empty{text-align:center;padding:55rpx 20rpx}.badge{font-size:22rpx;color:#52ddc8}.divider{height:1rpx;background:#273851;margin:22rpx 0}.step{display:flex;gap:20rpx;padding:20rpx 0;border-bottom:1rpx solid #22334a}.step-no{width:46rpx;height:46rpx;border:1rpx solid #456481;border-radius:50%;line-height:44rpx;text-align:center;flex-shrink:0;color:#8debd7}.done{background:#154a43;border-color:#30e0c1}.step-body{flex:1}.progress{height:10rpx;background:#25364f;border-radius:8rpx;margin:25rpx 0;overflow:hidden}.progress-fill{height:100%;background:#30e0c1;transition:width .4s}.pulse{animation:pulse 1.7s ease-in-out infinite}@keyframes pulse{50%{opacity:.45;transform:scale(.98)}}.small{font-size:23rpx}.gap{margin-top:24rpx}.inline-link{color:#5ee7d0;padding:18rpx 0}.pill{font-size:22rpx;border:1rpx solid #344a64;border-radius:40rpx;padding:14rpx 22rpx;margin:12rpx 10rpx 0 0;display:inline-block}